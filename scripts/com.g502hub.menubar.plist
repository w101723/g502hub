<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.g502hub.menubar</string>
    <key>ProgramArguments</key>
    <array>
        <string>@PROJECT_DIR@/g502hub.app/Contents/MacOS/g502hub</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string>/tmp/g502hub_menubar.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/g502hub_menubar.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
